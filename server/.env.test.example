
# Copy this file to .env.test for running the automated test suite.
# It MUST point at a separate database from .env — tests truncate/seed data
# and must never run against development or production data.

NODE_ENV=test
DATABASE_URL="postgresql://nightingale:nightingale@localhost:5432/nightingale_test?schema=public"

# Lets the webhook tests sign payloads. Never reuse a real secret here.
RAZORPAY_WEBHOOK_SECRET="test-webhook-secret"

# Test-only signing keys (never used outside the test suite).
JWT_ACCESS_SECRET="test-access-secret-0123456789abcdef0123456789"
JWT_REFRESH_SECRET="test-refresh-secret-0123456789abcdef012345678"
