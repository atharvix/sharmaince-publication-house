# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string (see docker-compose.yml for the local dev default)
DATABASE_URL="postgresql://nightingale:nightingale@localhost:5432/nightingale?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Auth — generate real random secrets for staging/production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Razorpay — leave the test-mode defaults to run checkout in dev-simulated mode
# (see src/lib/razorpay.ts). Replace with real test/live keys before going further than dev.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email — leave SMTP_HOST empty to log emails to the console instead of sending them
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Nightingale Academic Press <no-reply@nightingalepress.example>"

# Used to build links inside transactional emails (password reset, order confirmation)
PUBLIC_WEB_URL="http://localhost:5173"
