# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string (see docker-compose.yml for the local dev default)
DATABASE_URL="postgresql://nightingale:nightingale@localhost:5432/nightingale?schema=public"

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN="http://localhost:5173"
# Number of reverse proxies in front of the API (e.g. 1 behind a load balancer). Leave 0 locally.
TRUST_PROXY=0
# Log level: fatal | error | warn | info | debug | trace | silent (default: info, debug in dev)
# LOG_LEVEL=info

# Auth — at least 32 characters each and different from each other.
# Generate real secrets for anything beyond local dev: `openssl rand -hex 32`
JWT_ACCESS_SECRET="dev-only-access-secret-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="dev-only-refresh-secret-generate-with-openssl-rand-hex-32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Razorpay — leave empty in development to use simulated payments (see src/lib/razorpay.ts).
# Required in production: the server refuses to start without all three.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional. With a Claude API key (console.anthropic.com), uploading a cover photo in
# Admin → Books fills in the title, authors, bios and description automatically.
# Without it, covers are still straightened and cropped, and staff type the details.
ANTHROPIC_API_KEY=""

# Email — leave SMTP_HOST empty in development to log emails instead of sending them.
# Required in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Sharmiance Publication House <no-reply@sharmiance.example>"

# Unpaid orders are cancelled and their stock released after this many minutes
PENDING_ORDER_TTL_MINUTES=30

# Used to build links inside transactional emails (password reset, order confirmation). https in production.
PUBLIC_WEB_URL="http://localhost:5173"

# Host port for the docker postgres (only used by docker compose)
# POSTGRES_PORT=5432
